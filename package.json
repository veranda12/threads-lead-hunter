{
  "name": "threads-lead-hunter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker:discovery": "tsx --conditions=react-server scripts/run-discovery.ts",
    "demo:seed": "tsx scripts/demo-fixtures.ts seed",
    "demo:clear": "tsx scripts/demo-fixtures.ts clear",
    "postinstall": "prisma generate",
    "worker:analyze": "tsx --conditions=react-server scripts/run-analysis.ts",
    "eval:local-ai": "tsx --conditions=react-server scripts/eval-local-ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
